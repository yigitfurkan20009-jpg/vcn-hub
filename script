            })

            -- Sekmeler (Tabs)
            local Tabs = {
                Combat = Window:AddTab({ Title = "Aimbot", Icon = "swords" }),
                Visuals = Window:AddTab({ Title = "Esp", Icon = "eye" }),
                Movement = Window:AddTab({ Title = "Move", Icon = "move" }),
                Teleport = Window:AddTab({ Title = "Teleport", Icon = "map-pin" }),
